<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Rhino 8 runs plug-ins on .NET 7 (Core) and, in legacy mode, on .NET Framework 4.8.
         Building both target frameworks produces one .rhp that loads in either runtime. -->
    <TargetFrameworks>net7.0-windows;net48</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- A Rhino plug-in is a .NET assembly with the .rhp extension. -->
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>Stratum</AssemblyName>
    <RootNamespace>Stratum</RootNamespace>

    <Version>0.9.0</Version>
    <Title>Stratum BIM</Title>
    <Company>Stratum</Company>
    <Description>Parametric layered (BIM) wall assemblies for Rhino 8.</Description>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>

    <!-- Required so the .NET 7 build emits a deps.json Rhino can use to resolve
         the plug-in's private dependencies. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <NoWarn>MSB3277;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- One package, and only one.
         The RhinoCommon package ships RhinoCommon.dll, Rhino.UI.dll, Eto.dll and
         Ed.Eto.dll together, so the Eto used at compile time is exactly the Eto that
         Rhino loads. Do NOT add a separate Eto.Forms PackageReference: it resolves a
         different Eto build (Rhino 8.19 ships Eto 2.9, 8.34 ships 2.11) and the two
         identities collide at load time.

         Version 8.19.25132.1001 is the earliest RhinoCommon that publishes a real
         lib/net7.0 target - every package before it is net48-only and can be consumed
         from a .NET 7 project only through NuGet's asset fallback. Raising this is safe;
         lowering it below 8.19 means re-adding <NoWarn>NU1701</NoWarn> and accepting the
         fallback.

         ExcludeAssets="runtime" is mandatory: Rhino supplies these assemblies at run
         time, and copying them next to the .rhp gives two copies of RhinoCommon and a
         plug-in that fails to load. -->
    <PackageReference Include="RhinoCommon" Version="8.19.25132.1001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rhino auto-loads a toolbar file that sits beside the .rhp and shares its name. -->
    <None Update="Stratum.rui">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="EmbeddedResources\**\*.png" />
  </ItemGroup>

</Project>
