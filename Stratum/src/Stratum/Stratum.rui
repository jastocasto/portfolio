<?xml version="1.0" encoding="utf-8"?>
<!--
  Stratum BIM toolbar.

  Rhino loads a .rui that sits next to the .rhp and shares its file name, so
  keeping this beside Stratum.rhp is all that is needed - the toolbar appears
  the first time the plug-in loads and is remembered afterwards.

  If you would rather build the toolbar by hand, Tools > Toolbar Layout > File >
  New will create an empty one, and every button below is just a macro that runs
  the named command.
-->
<RhinoUI major_ver="3" minor_ver="0" guid="2967690c-6eb4-4739-bbce-88fd0ff35ec5"
         localizeStrings="False" default_language_id="1033">

  <macros>
    <macro_item guid="e184d95a-be52-497d-b591-8b1acb221f4c">
      <text>Wall</text>
      <tooltip>Draw a parametric layered wall</tooltip>
      <help_text>Pick points to draw walls. Every layer of the assembly is drawn in 3-D as you go.</help_text>
      <button_text>Wall</button_text>
      <menu_text>Draw &amp;Wall</menu_text>
      <script>! _BimWall</script>
    </macro_item>

    <macro_item guid="fae81706-d752-475e-8291-077e4bab5b07">
      <text>Opening</text>
      <tooltip>Insert a window, door or opening into a wall</tooltip>
      <help_text>Cuts every layer of the host wall according to that layer's jamb, head and sill rule.</help_text>
      <button_text>Open</button_text>
      <menu_text>Insert &amp;Opening</menu_text>
      <script>! _BimOpening</script>
    </macro_item>

    <macro_item guid="86f8840e-f97d-4327-9028-4bda5838281c">
      <text>Floor</text>
      <tooltip>Floor a room by clicking inside it, or from picked curves</tooltip>
      <button_text>Floor</button_text>
      <menu_text>Draw &amp;Floor</menu_text>
      <script>! _BimFloor</script>
    </macro_item>

    <macro_item guid="8dba7e64-58c6-4c9a-8939-b6fe0ecea822">
      <text>Roof</text>
      <tooltip>Build a layered roof off a surface you drew</tooltip>
      <button_text>Roof</button_text>
      <menu_text>Build &amp;Roof</menu_text>
      <script>! _BimRoof</script>
    </macro_item>

    <macro_item guid="87583397-7c3a-426e-89c5-22d010493443">
      <text>Edit wall</text>
      <tooltip>Retype, re-height or re-justify selected walls</tooltip>
      <button_text>Edit</button_text>
      <menu_text>&amp;Edit Walls</menu_text>
      <script>! _BimWallEdit</script>
    </macro_item>

    <macro_item guid="9d871820-9204-4e28-b232-ad97eeba023f">
      <text>Wall top</text>
      <tooltip>Set a wall to a height, up to a level, or raked to a roof surface</tooltip>
      <button_text>Top</button_text>
      <menu_text>Wall &amp;Top Condition</menu_text>
      <script>! _BimWallTop</script>
    </macro_item>

    <macro_item guid="2e27740e-42f0-47ea-91eb-1ae562409238">
      <text>Levels</text>
      <tooltip>Add, rename, move or delete building levels</tooltip>
      <button_text>Lvl</button_text>
      <menu_text>Building &amp;Levels</menu_text>
      <script>! _BimLevels</script>
    </macro_item>

    <macro_item guid="92471ca1-231a-4fe2-93aa-23d16ec96486">
      <text>Wall panel</text>
      <tooltip>Open the BIM Wall properties panel</tooltip>
      <button_text>Panel</button_text>
      <menu_text>Wall &amp;Properties Panel</menu_text>
      <script>! _BimWallProperties</script>
    </macro_item>

    <macro_item guid="2834d287-b923-4cde-80c6-48054ef76f8d">
      <text>Wall types</text>
      <tooltip>Edit wall types and the product catalog</tooltip>
      <button_text>Types</button_text>
      <menu_text>Wall &amp;Types and Products</menu_text>
      <script>! _BimAssemblies</script>
    </macro_item>

    <macro_item guid="dc6eea48-bcd6-4bc9-a0a3-ade7ab0e25a4">
      <text>Library</text>
      <tooltip>Save or load the shared office library</tooltip>
      <button_text>Lib</button_text>
      <menu_text>Shared &amp;Library</menu_text>
      <script>! _BimLibrary</script>
    </macro_item>

    <macro_item guid="4f3dce33-d6b9-4526-93fc-5c3e56b252d0">
      <text>Section styles</text>
      <tooltip>Apply, refresh or remove the per-material section hatching</tooltip>
      <help_text>Walls carry their own section style, so a clipping plane cuts a hatched, poched construction section.</help_text>
      <button_text>Sect</button_text>
      <menu_text>&amp;Section Styles</menu_text>
      <script>! _BimSectionStyles</script>
    </macro_item>

    <macro_item guid="36d52bec-b73b-48b7-a248-344bac5d0d82">
      <text>Schedule</text>
      <tooltip>Export the wall and material takeoff as CSV</tooltip>
      <button_text>Sched</button_text>
      <menu_text>Export &amp;Schedule</menu_text>
      <script>! _BimSchedule</script>
    </macro_item>

    <macro_item guid="d9e47859-093f-46da-88f9-2a2e8ead2b7a">
      <text>Rebuild</text>
      <tooltip>Regenerate every wall from its parameters</tooltip>
      <button_text>Rebuild</button_text>
      <menu_text>&amp;Rebuild All Walls</menu_text>
      <script>! _BimRebuild</script>
    </macro_item>

    <macro_item guid="56c64a99-622f-478d-8751-f36b840313ae">
      <text>Help</text>
      <tooltip>List the Stratum commands</tooltip>
      <button_text>?</button_text>
      <menu_text>Stratum &amp;Help</menu_text>
      <script>! _BimHelp</script>
    </macro_item>
  </macros>

  <tool_bar_groups>
    <tool_bar_group guid="5a7961c0-2eae-42cd-bfa1-76dc4691a96c"
                    name="Stratum BIM" visible="True" docked="False"
                    point="200,200" single_file="True">
      <tool_bar_group_item guid="6742354d-d631-4fc1-8952-4e82c047abfa"
                           tool_bar_guid="04ccd2e9-49cf-493e-ad53-aa10554dd2d4" />
    </tool_bar_group>
  </tool_bar_groups>

