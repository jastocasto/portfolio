<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs assertions against Stratum's real source, on any machine, without Rhino.

    Two deliberate choices:

    * It compiles the Core and Modeling sources directly rather than referencing
      the plug-in project. A Rhino plug-in's output is named .rhp, and the .NET
      host refuses to put a non-.dll on its trusted assembly list, so referencing
      it fails at CoreCLR startup. Compiling the same files sidesteps that and
      still tests the same code.

    * The RhinoCommon assembly in the NuGet package is a REFERENCE assembly. The
      runtime refuses to load it for execution, so a method can only run here if
      no Rhino type appears anywhere in its body - not merely if the Rhino code
      path is skipped, since the JIT resolves types when it compiles the method.

      That draws a hard line: the justification maths, the tee arithmetic, the
      level resolution, the section rules and the unit parser are all testable.
      Anything that touches Curve, Brep, RhinoDoc or the document tables is not,
      and is verified in Rhino by hand.

    Run it with "dotnet run" pointed at this project; the command is in BUILD.md.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 so it runs on a current runtime; the plug-in itself stays on
         net7.0-windows, which is what Rhino 8 loads. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <AssemblyName>StratumTests</AssemblyName>
    <RootNamespace>Stratum.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>MSB3277;NETSDK1138</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Stratum\Core\*.cs" />
    <Compile Include="..\..\src\Stratum\Modeling\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.19.25132.1001" />
  </ItemGroup>

</Project>
